<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /manager/

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule ^api/(.*)$ /api/index.php?path=$1 [QSA,L]
  RewriteRule ^(.*)$ /manager/index.php?path=$1 [QSA,L]
</IfModule>

<FilesMatch "^\.">
  Deny from all
</FilesMatch>
