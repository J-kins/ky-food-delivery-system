<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # SPA fallback — all unmatched routes serve this portal's index.html
  RewriteRule ^(.*)$ /public/index.html [QSA,L]
</IfModule>

<FilesMatch "^\.">
  Deny from all
</FilesMatch>
