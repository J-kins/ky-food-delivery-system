{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "{{DEV_URL}}",
    "beforeDevCommand": "npm run dev:{{APP_NAME}}",
    "beforeBuildCommand": "npm run build:{{APP_NAME}}"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "{{TARGETS}}",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "keystorePath": null,
      "keystorePassword": null,
      "keyAlias": null,
      "keyPassword": null
    },
    "ios": {
      "developmentTeam": null,
      "signingIdentity": null
    }
  }
}