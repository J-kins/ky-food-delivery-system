{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ky-food-delivery-system",
  "version": "0.1.0",
  "identifier": "com.kyfoods.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "public",
        "title": "KY Foods - Ordering",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "public/index.html"
      },
      {
        "label": "admin",
        "title": "KY Foods - Admin Dashboard",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "admin/index.html",
        "visible": false
      },
      {
        "label": "kitchen",
        "title": "KY Foods - Kitchen Display",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "kitchen/index.html",
        "visible": false
      },
      {
        "label": "manager",
        "title": "KY Foods - Restaurant Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "manager/index.html",
        "visible": false
      },
      {
        "label": "delivery",
        "title": "KY Foods - Delivery Management",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "delivery/index.html",
        "visible": false
      },
      {
        "label": "dispatcher",
        "title": "KY Foods - Dispatcher",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "delivery/dispatcher.html",
        "visible": false
      },
      {
        "label": "rider",
        "title": "KY Foods - Rider",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "delivery/rider.html",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "keystorePath": null,
      "keystorePassword": null,
      "keyAlias": null,
      "keyPassword": null
    },
    "ios": {
      "developmentTeam": null,
      "signingIdentity": null
    }
  }
}