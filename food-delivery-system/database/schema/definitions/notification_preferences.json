{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notification_preferences",
  "type": "object",
  "properties": {
    "preference_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL"
    },
    "type_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 NOTIFICATION_TYPES, NOT NULL"
    },
    "app_enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "email_enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "sms_enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "preference_id",
    "type_id",
    "user_id"
  ]
}