{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "food_addons",
  "type": "object",
  "properties": {
    "addon_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "food_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 FOODS, NOT NULL"
    },
    "addon_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | e.g., \"Sauces\", \"Sides\", \"Toppings\""
    },
    "name": {
      "type": "string",
      "description": "Constraints: NOT NULL | e.g., Extra Sauce / Coleslaw / Jalape\u00f1os"
    },
    "price": {
      "type": "number",
      "description": "Constraints: NOT NULL | Additional cost"
    },
    "max_quantity": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 1 | Max units per order item"
    },
    "is_available": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "is_required": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE | Must be selected to proceed"
    }
  },
  "required": [
    "addon_id",
    "food_id",
    "name",
    "price"
  ]
}