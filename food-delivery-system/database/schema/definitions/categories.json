{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "categories",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "parent_category_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 CATEGORIES, NULLABLE | For nested sub-categories"
    },
    "name": {
      "type": "string",
      "description": "Constraints: NOT NULL | e.g., Burgers, Grills, Sides, Drinks"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "display_order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0 | Sort order on the menu page"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "category_id",
    "name"
  ]
}