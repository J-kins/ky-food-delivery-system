{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "otp_verifications",
  "type": "object",
  "properties": {
    "otp_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS"
    },
    "channel": {
      "type": "string",
      "description": "Constraints: NOT NULL | Email / SMS"
    },
    "otp_code": {
      "type": "string",
      "description": "Constraints: NOT NULL | 4\u20136 digit hashed code"
    },
    "purpose": {
      "type": "string",
      "description": "Constraints: NOT NULL | Registration / Login / Reset / Payment"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Constraints: NOT NULL"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE | Timestamp when used"
    },
    "attempts": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0 | Number of failed attempts"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "channel",
    "expires_at",
    "otp_code",
    "otp_id",
    "purpose"
  ]
}