{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payment_methods",
  "type": "object",
  "properties": {
    "method_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL"
    },
    "method_type": {
      "type": "string",
      "description": "Constraints: NOT NULL | Mobile Money / Credit Card / Debit Card / Cash / Wallet"
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | MTN, Airtel, Visa, Mastercard"
    },
    "account_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Encrypted / masked"
    },
    "account_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "expiry_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Constraints: NULLABLE | For cards"
    },
    "is_default": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "method_id",
    "method_type",
    "user_id"
  ]
}