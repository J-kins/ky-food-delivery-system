{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "featured_foods",
  "type": "object",
  "properties": {
    "feature_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "food_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 FOODS, NOT NULL"
    },
    "feature_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | e.g., \"Chef's Pick\", \"Best Seller\", \"New\""
    },
    "display_order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_by": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "created_by",
    "feature_id",
    "food_id"
  ]
}