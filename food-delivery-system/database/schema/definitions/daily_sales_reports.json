{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "daily_sales_reports",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "branch_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 STORE_BRANCHES, NULLABLE | NULL = whole store"
    },
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Constraints: NOT NULL"
    },
    "total_orders": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "completed_orders": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "cancelled_orders": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "gross_revenue": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00 | Before fees / discounts"
    },
    "total_delivery_fees": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00"
    },
    "total_tax": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00"
    },
    "total_discounts": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00"
    },
    "net_revenue": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00 | After all deductions"
    },
    "most_ordered_foods": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Constraints: NULLABLE | Top 5 food_ids + order counts"
    },
    "new_customers": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0 | First-time orderers today"
    },
    "returning_customers": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "avg_order_value": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "report_date",
    "report_id"
  ]
}