{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "carts",
  "type": "object",
  "properties": {
    "cart_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL | Cart owner"
    },
    "coupon_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 COUPONS, NULLABLE | Applied coupon code"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Overall order note from customer"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Auto-clear after inactivity (e.g., 30 min)"
    }
  },
  "required": [
    "cart_id",
    "user_id"
  ]
}