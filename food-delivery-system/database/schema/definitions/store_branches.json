{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "store_branches",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "branch_name": {
      "type": "string",
      "description": "Constraints: NOT NULL | e.g., \"KY Foods \u2014 Kampala Central\""
    },
    "manager_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS, NULLABLE | Branch manager user account"
    },
    "street": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "city": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "latitude": {
      "type": "number",
      "description": "Constraints: NOT NULL"
    },
    "longitude": {
      "type": "number",
      "description": "Constraints: NOT NULL"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Branch-specific contact"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "branch_id",
    "branch_name",
    "city",
    "latitude",
    "longitude",
    "street"
  ]
}