{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "food_variants",
  "type": "object",
  "properties": {
    "variant_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "food_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 FOODS, NOT NULL"
    },
    "variant_name": {
      "type": "string",
      "description": "Constraints: NOT NULL | Small / Medium / Large / Boneless / etc."
    },
    "variant_price": {
      "type": "number",
      "description": "Constraints: NOT NULL | Price for this variant"
    },
    "variant_sku": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "calories": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "stock_quantity": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: NULLABLE | NULL = unlimited"
    },
    "is_available": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "display_order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    }
  },
  "required": [
    "food_id",
    "variant_id",
    "variant_name",
    "variant_price"
  ]
}