{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "faqs",
  "type": "object",
  "properties": {
    "faq_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "question": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "answer": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "description": "Orders / Payments / Delivery / Account / Menu"
    },
    "display_order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "helpful_count": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "not_helpful_count": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "answer",
    "faq_id",
    "question"
  ]
}