{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kitchen_orders",
  "type": "object",
  "properties": {
    "kitchen_order_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "order_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 ORDERS, NOT NULL"
    },
    "branch_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 STORE_BRANCHES, NULLABLE | Which branch is preparing"
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: DEFAULT 'PENDING' | Pending / Preparing / Completed / Cancelled"
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 1 | 1 = highest priority"
    },
    "assigned_to": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS, NULLABLE | Kitchen staff member"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "kitchen_order_id",
    "order_id"
  ]
}