{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notifications",
  "type": "object",
  "properties": {
    "notification_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL | Recipient"
    },
    "type_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 NOTIFICATION_TYPES, NOT NULL"
    },
    "order_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 ORDERS, NULLABLE"
    },
    "delivery_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 DELIVERIES, NULLABLE"
    },
    "title": {
      "type": "string",
      "description": "Constraints: NOT NULL | Rendered title"
    },
    "message": {
      "type": "string",
      "description": "Constraints: NOT NULL | Rendered body"
    },
    "data": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Constraints: NULLABLE | Deep-link data payload"
    },
    "channel": {
      "type": "string",
      "description": "Constraints: NOT NULL | App / Email / SMS / All"
    },
    "is_read": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE"
    },
    "read_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "failed_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "channel",
    "message",
    "notification_id",
    "title",
    "type_id",
    "user_id"
  ]
}