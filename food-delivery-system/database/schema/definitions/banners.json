{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "banners",
  "type": "object",
  "properties": {
    "banner_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "title": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "image_url": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "link_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Deep-link or external URL"
    },
    "link_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Food / Category / Promotion / Page"
    },
    "link_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: NULLABLE | ID of the linked entity"
    },
    "placement": {
      "type": "string",
      "description": "Constraints: NOT NULL | Home / Menu / Checkout"
    },
    "display_order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: DEFAULT 0"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_by": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "banner_id",
    "created_by",
    "image_url",
    "placement",
    "title"
  ]
}