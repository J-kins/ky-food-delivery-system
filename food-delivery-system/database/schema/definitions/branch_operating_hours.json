{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "branch_operating_hours",
  "type": "object",
  "properties": {
    "hours_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "branch_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 STORE_BRANCHES, NOT NULL"
    },
    "day_of_week": {
      "type": "integer",
      "description": "Constraints: NOT NULL | 0 = Sunday \u2026 6 = Saturday"
    },
    "opening_time": {
      "type": "string",
      "format": "time",
      "description": "Constraints: NOT NULL"
    },
    "closing_time": {
      "type": "string",
      "format": "time",
      "description": "Constraints: NOT NULL"
    },
    "is_closed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE"
    }
  },
  "required": [
    "branch_id",
    "closing_time",
    "day_of_week",
    "hours_id",
    "opening_time"
  ]
}