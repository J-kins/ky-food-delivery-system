{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payments",
  "type": "object",
  "properties": {
    "payment_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "order_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 ORDERS, NOT NULL"
    },
    "user_id": {
      "type": "integer",
      "description": "Constraints: FK \u2192 USERS, NOT NULL"
    },
    "payment_method_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 PAYMENT_METHODS, NULLABLE | NULL = Cash on Delivery"
    },
    "amount": {
      "type": "number",
      "description": "Constraints: NOT NULL"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: DEFAULT 'UGX'"
    },
    "transaction_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: UNIQUE, NULLABLE | ID from payment gateway"
    },
    "gateway_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | MTN API / Airtel Money / Flutterwave / Stripe"
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: DEFAULT 'PENDING' | Pending / Completed / Failed / Refunded / Partially Refunded"
    },
    "gateway_response": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Constraints: NULLABLE | Raw response from payment provider"
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "paid_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "refunded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "refund_amount": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00"
    },
    "refund_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "refunded_by": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS, NULLABLE | Admin who processed the refund"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "amount",
    "order_id",
    "payment_id",
    "user_id"
  ]
}