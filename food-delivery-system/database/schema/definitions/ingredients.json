{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ingredients",
  "type": "object",
  "properties": {
    "ingredient_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "name": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "unit": {
      "type": "string",
      "description": "Constraints: NOT NULL | kg / g / L / mL / pieces"
    },
    "minimum_stock": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00 | Low-stock alert threshold"
    },
    "current_stock": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00"
    },
    "cost_per_unit": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: NULLABLE | For food cost tracking"
    },
    "supplier_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "supplier_contact": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "last_restocked": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: NULLABLE"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "ingredient_id",
    "name",
    "unit"
  ]
}