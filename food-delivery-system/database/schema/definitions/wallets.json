{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wallets",
  "type": "object",
  "properties": {
    "wallet_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS, UNIQUE | One wallet per customer"
    },
    "balance": {
      "type": [
        "number",
        "null"
      ],
      "description": "Constraints: DEFAULT 0.00 | Current available balance"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: DEFAULT 'UGX'"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "wallet_id"
  ]
}