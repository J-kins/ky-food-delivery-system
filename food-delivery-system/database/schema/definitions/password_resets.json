{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "password_resets",
  "type": "object",
  "properties": {
    "reset_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS"
    },
    "token": {
      "type": "string",
      "description": "Constraints: UNIQUE, NOT NULL | Hashed one-time reset token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Constraints: NOT NULL"
    },
    "is_used": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT FALSE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "expires_at",
    "reset_id",
    "token"
  ]
}