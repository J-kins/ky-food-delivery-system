{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "menus",
  "type": "object",
  "properties": {
    "menu_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "name": {
      "type": "string",
      "description": "Constraints: NOT NULL"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE"
    },
    "is_active": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Constraints: DEFAULT TRUE"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Constraints: NULLABLE | For limited-time menus"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Constraints: NULLABLE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Constraints: DEFAULT NOW()"
    }
  },
  "required": [
    "menu_id",
    "name"
  ]
}