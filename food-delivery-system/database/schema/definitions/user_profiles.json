{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "user_profiles",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "integer",
      "description": "Constraints: PK, AUTO_INCREMENT"
    },
    "user_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Constraints: FK \u2192 USERS, UNIQUE | One-to-one with Users"
    },
    "date_of_birth": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Constraints: NULLABLE"
    },
    "gender": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Male / Female / Other / Prefer not to say"
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "description": "Constraints: NULLABLE | Short personal description"
    },
    "dietary_preferences": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Constraints: NULLABLE | e.g., [\"Vegetarian\", \"Halal\"]"
    },
    "favourite_food_categories": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Constraints: NULLABLE | e.g., [\"Burgers\", \"Grills\"] \u2014 KY Foods categories"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "profile_id"
  ]
}