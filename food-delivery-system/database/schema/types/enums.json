{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Global Enums",
  "type": "object",
  "properties": {
    "OrderStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Accepted",
        "Preparing",
        "Ready",
        "Out for Delivery",
        "Delivered",
        "Cancelled"
      ]
    },
    "PaymentStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Completed",
        "Failed",
        "Refunded"
      ]
    }
  }
}