<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /delivery/

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule ^api/(.*)$ /api/index.php?path=$1 [QSA,L]
  RewriteRule ^(.*)$ /delivery/index.php?path=$1 [QSA,L]
</IfModule>

<FilesMatch "^\.">
  Deny from all
</FilesMatch>
