digraph "problem_tree" {
  graph [bgcolor=white fontname=Arial];
  rankdir=TB;
  node [shape=box style="rounded,filled" fontname=Arial fontsize=10 margin="0.2,0.1"];
  edge [color="#666666" fontname=Arial fontsize=9];
  "ROOT" [label="Fragmented, Inefficient, and Inaccessible Healthcare" shape=box fillcolor="#C62828" color="#B71C1C" fontcolor="#FFFFFF"];
  "BRANCH-1" [label="Fragmented Patient Records" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-2" [label="Poor Healthcare Access" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-3" [label="Inefficient Referrals" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-4" [label="Emergency Response Delays" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-5" [label="Medicine Stock-outs" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-6" [label="Limited Healthcare Analytics" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "BRANCH-7" [label="Workforce Capacity Gaps" shape=box fillcolor="#EF5350" color="#C62828" fontcolor="#FFFFFF"];
  "LEAF-1-1" [label="No shared EHR across facilities" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-1-2" [label="Paper-based records" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-2-1" [label="No facility locator" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-2-2" [label="Limited rural coverage" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-3-1" [label="No electronic referrals" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-3-2" [label="Referral loss/fragmentation" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-4-1" [label="No integrated dispatch" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-4-2" [label="No ambulance tracking" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-5-1" [label="No real-time inventory" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-5-2" [label="No expiry tracking" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-6-1" [label="No national health data" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-6-2" [label="No disease surveillance" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-7-1" [label="Limited digital literacy among health workers" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-7-2" [label="Shortage of trained GIS/health-informatics specialists" shape=ellipse fillcolor="#FFCDD2" color="#E57373" fontcolor="#333333"];
  "LEAF-1-1" -> "BRANCH-1"[ color="#666666"];
  "LEAF-1-2" -> "BRANCH-1"[ color="#666666"];
  "LEAF-2-1" -> "BRANCH-2"[ color="#666666"];
  "LEAF-2-2" -> "BRANCH-2"[ color="#666666"];
  "LEAF-3-1" -> "BRANCH-3"[ color="#666666"];
  "LEAF-3-2" -> "BRANCH-3"[ color="#666666"];
  "LEAF-4-1" -> "BRANCH-4"[ color="#666666"];
  "LEAF-4-2" -> "BRANCH-4"[ color="#666666"];
  "LEAF-5-1" -> "BRANCH-5"[ color="#666666"];
  "LEAF-5-2" -> "BRANCH-5"[ color="#666666"];
  "LEAF-6-1" -> "BRANCH-6"[ color="#666666"];
  "LEAF-6-2" -> "BRANCH-6"[ color="#666666"];
  "LEAF-7-1" -> "BRANCH-7"[ color="#666666"];
  "LEAF-7-2" -> "BRANCH-7"[ color="#666666"];
  "BRANCH-1" -> "ROOT"[ color="#666666"];
  "BRANCH-2" -> "ROOT"[ color="#666666"];
  "BRANCH-3" -> "ROOT"[ color="#666666"];
  "BRANCH-4" -> "ROOT"[ color="#666666"];
  "BRANCH-5" -> "ROOT"[ color="#666666"];
  "BRANCH-6" -> "ROOT"[ color="#666666"];
  "BRANCH-7" -> "ROOT"[ color="#666666"];
}