      "id": "RSK-02",
      "description": "Clinic connectivity delays pilot rollout",
      "likelihood": 4,
      "impact": 3,
      "mitigation": "Pre-site surveys; backup mobile hotspot kits for 10 clinics"
    },
    {
      "id": "RSK-03",
