digraph "problem_tree" {
  graph [bgcolor=white fontname=Arial];
  rankdir=TB;
  node [shape=box style="rounded,filled" fontname=Arial fontsize=10 margin="0.2,0.1"];
  edge [color="#666666" fontname=Arial fontsize=9];
  subgraph "cluster_roots" {
    label="roots";
  "RSK-01" [label="RSK-01: NHIS API changes break billing integration" shape=box fillcolor="#EF9A9A" color="#E53935" fontcolor="#000000"];
  "RSK-02" [label="RSK-02: Clinic connectivity delays pilot rollout" shape=box fillcolor="#EF9A9A" color="#E53935" fontcolor="#000000"];
  "RSK-03" [label="RSK-03: Security audit findings delay go-live" shape=box fillcolor="#EF9A9A" color="#E53935" fontcolor="#000000"];
  }
  subgraph "cluster_branches" {
    label="branches";
  "OBJ-01" [label="OBJ-01: Deliver FHIR-compliant data exchange between 50 pilot clinic" shape=box fillcolor="#90CAF9" color="#1565C0" fontcolor="#000000"];
  "OBJ-02" [label="OBJ-02: Reduce patient record retrieval time for CHWs" shape=box fillcolor="#90CAF9" color="#1565C0" fontcolor="#000000"];
  "OBJ-03" [label="OBJ-03: Train 200 community health workers on the platform" shape=box fillcolor="#90CAF9" color="#1565C0" fontcolor="#000000"];
  }
  subgraph "cluster_leaves" {
    label="leaves";
  "L1" [label="50 clinics connected with verified data exchange" shape=box fillcolor="#A5D6A7" color="#2E7D32" fontcolor="#000000"];
  "L2" [label="Median record retrieval under 2 seconds" shape=box fillcolor="#A5D6A7" color="#2E7D32" fontcolor="#000000"];
  "L3" [label="200 CHWs trained and actively using the platform" shape=box fillcolor="#A5D6A7" color="#2E7D32" fontcolor="#000000"];
  }
  "TRUNK" [label="Enable every community health worker in Uganda to access trusted, interoperable patient data through a secure national platform." shape=box fillcolor="#FFCC80" color="#F57C00" fontcolor="#000000"];
  "RSK-01" -> "TRUNK"[ color="#666666"];
  "RSK-02" -> "TRUNK"[ color="#666666"];
  "RSK-03" -> "TRUNK"[ color="#666666"];
  "TRUNK" -> "OBJ-01"[ color="#666666"];
  "TRUNK" -> "OBJ-02"[ color="#666666"];
  "TRUNK" -> "OBJ-03"[ color="#666666"];
  "OBJ-01" -> "L1"[ color="#666666"];
  "OBJ-02" -> "L1"[ color="#666666"];
  "OBJ-03" -> "L1"[ color="#666666"];
  "OBJ-01" -> "L2"[ color="#666666"];
  "OBJ-02" -> "L2"[ color="#666666"];
  "OBJ-03" -> "L2"[ color="#666666"];
  "OBJ-01" -> "L3"[ color="#666666"];
  "OBJ-02" -> "L3"[ color="#666666"];
  "OBJ-03" -> "L3"[ color="#666666"];
}