        "line_style": "solid"
      },
      {
        "id": "L2",
        "source": "P2",
        "target": "P3",
        "type": "association",
        "line_style": "solid"
      },
      {
        "id": "L3",
        "source": "P2",
        "target": "P4",
        "type": "association",
        "line_style": "solid"
      },
      {
        "id": "L4",
        "source": "P2",
        "target": "P5",
        "type": "association",
        "line_style": "solid"
      },
      {
        "id": "L5",
        "source": "P4",
        "target": "P5",
        "type": "dependency",
        "line_style": "dashed"
      }
    ],
    
    "messages": [
      {
        "id": "M1",
        "from": "P1",
        "to": "P2",
        "sequence": "1",
        "label": "Book Appointment",
        "type": "synchronous",
        "return_value": "confirmation"
      },
      {
        "id": "M2",
        "from": "P2",
        "to": "P3",
        "sequence": "1.1",
        "label": "Check Availability",
        "type": "synchronous",
        "return_value": "slots"
      },
      {
        "id": "M3",
        "from": "P3",
        "to": "P2",
        "sequence": "1.1.1",
        "label": "Return Available Slots",
        "type": "synchronous",
        "return_value": "List<Slot>"
      },
      {
        "id": "M4",
        "from": "P2",
        "to": "P1",
        "sequence": "1.2",
        "label": "Show Available Slots",
        "type": "synchronous"
      },
      {
        "id": "M5",
        "from": "P1",
        "to": "P2",
        "sequence": "1.3",
        "label": "Select Slot and Book",
        "type": "synchronous",
        "return_value": "Booking"
      },
      {
        "id": "M6",
        "from": "P2",
        "to": "P4",
        "sequence": "1.4",
        "label": "Schedule Consultation",
        "type": "synchronous"
      },
      {
        "id": "M7",
        "from": "P2",
        "to": "P5",
        "sequence": "1.5",
        "label": "Record Booking",
        "type": "synchronous"
      },
      {
        "id": "M8",
        "from": "P4",
        "to": "P5",
        "sequence": "2",
        "label": "Record Consultation",
        "type": "synchronous",
        "guard": "consultation_complete"
      }
    ],
    
    "groups": [
      {
        "id": "G1",
        "name": "Healthcare System",
        "participants": ["P2", "P3", "P4", "P5"]
      }
    ],
    
    "styling": {
      "theme": "enterprise_blue",
      "font_family": "Arial",
      "font_size": 9,
      "shadow_enabled": true
